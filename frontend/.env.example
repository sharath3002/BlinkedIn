# Points the frontend at your backend. Local dev: http://localhost:8000
# Netlify prod: your Railway/Render backend URL (e.g. https://blinkedinjobs-api.up.railway.app)
REACT_APP_BACKEND_URL=http://localhost:8000

# From https://console.cloud.google.com/apis/credentials — same Client ID as
# GOOGLE_CLIENT_ID in the backend's .env. Leave blank to just hide the Google button.
REACT_APP_GOOGLE_CLIENT_ID=

WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
